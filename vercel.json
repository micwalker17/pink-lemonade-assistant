{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    {
      "source": "/cdn/:path*",
      "destination": "https://pinklemonademi.com/cdn/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/connect/:provider/callback",
      "destination": "/api/connect?provider=:provider&step=callback"
    },
    {
      "source": "/connect/:provider",
      "destination": "/api/connect?provider=:provider"
    },
    {
      "source": "/analytics",
      "destination": "/pl-assistant/analytics.html"
    },
    {
      "source": "/:path((?!api/|pl-assistant/).*)",
      "destination": "/api/proxy?path=/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/insights.js": {
      "maxDuration": 60
    }
  }
}
